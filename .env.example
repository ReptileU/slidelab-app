# Скопируйте в .env и заполните. .env в git не попадает.
# Имена — как в прежнем settings.txt: его строки можно просто перенести сюда.

# --- Telegram ---
BOT_TOKEN=123456:replace-me
BOT_USERNAME=slidelab_order_bot
# Ваш Telegram ID: напишите боту /id. Сюда приходят заявки, чеки и работы Claude на проверку
ADMIN_ID=
ADMIN_USERNAME=slidelab_uz
# Необязательно: супергруппа с темами для команды менеджеров и их ID через запятую
MANAGERS_CHAT_ID=
MANAGER_IDS=

# --- Оплата ---
PAY_UZUM=
PAY_PAYME=
PAY_ZOOMRAD=
PAY_NAME=
# Звёзды Telegram (0 — выключить). Курс сум → звезда меняется в базе: price_rules.uzs_per_star
STARS=1
# Сколько дней после сдачи заказ можно засчитать в пакет (0 — выключить)
CREDIT_DAYS=3
# Подарок за пакет «эмодзи:звёзды», пусто — без подарка; акция до даты включительно
GIFT_WEEK=🧸:15
GIFT_MONTH=🌹:25
GIFT_VIP=🏆:100
GIFT_UNTIL=2026-11-30

# --- Mini App ---
# Старая витрина на GitHub Pages (кнопка «Заказать в приложении» у поля ввода)
MINIAPP_URL=https://reptileu.github.io/slidelab-app/
LEGACY_WEBAPP=true
# Кнопка меню слева от поля ввода (открывает Mini App). Значок — эмодзи в начале, до 64 символов
MENU_BUTTON=📊 SlideLab
# Новая Mini App: адрес сервера с API, например https://app.slidelab.uz/ и LEGACY_WEBAPP=false

# --- Канал ---
CHANNEL_URL=https://t.me/slidelab_uz
# Необязательно: @канал для публикации постов, если он не совпадает с CHANNEL_URL
POST_CHANNEL=
# Необязательно: отдельный бот только для публикации постов
POST_BOT_TOKEN=

# --- Где хранить данные ---
# Домашний компьютер — файл SQLite рядом с ботом:
DATABASE_URL=sqlite+aiosqlite:///data/slidelab.db
# Сервер — PostgreSQL и Redis (docker compose -p slidelab up -d):
# DATABASE_URL=postgresql+asyncpg://slidelab:slidelab@localhost:5433/slidelab
# REDIS_URL=redis://localhost:6380/0
# Пусто — состояние диалогов в памяти (на компьютере этого достаточно)
REDIS_URL=
# Папка конвейера Claude (orders/<номер>/brief.json, review/…) и контента канала (posts/, media/, portfolio/).
# Сессия Claude работала с bot/orders прежнего бота: укажите здесь полный путь к той же папке —
# или перенесите её сюда и поправьте путь в задании Claude.
WORK_DIR=orders
CONTENT_DIR=content
# Сторож: сколько часов ждать результат Claude, прежде чем предупредить
STUCK_HOURS=3

# --- Сервер (необязательно) ---
# Пусто — бот опрашивает Telegram сам (long polling). На сервере: https://bot.slidelab.uz
WEBHOOK_URL=
WEBHOOK_SECRET=
API_CORS_ORIGINS=
# Порт бота для webhook
BOT_PORT=8080
# Сколько секунд действительны данные входа из Mini App
INIT_DATA_TTL=86400
# Только для разработки Mini App в браузере без Telegram: ваш Telegram ID
DEV_TG_ID=
